// Merge this "mcp" block into ~/.config/opencode/opencode.jsonc.
// Servers referenced by name only in the Claude agents (configure separately): ['github']
{
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "lldb": {
      "type": "local",
      "command": [
        "lldb-mcp"
      ],
      "enabled": true
    },
    "cpp-lsp": {
      "type": "local",
      "command": [
        "mcp-language-server",
        "--workspace",
        ".",
        "--lsp",
        "clangd",
        "--",
        "--background-index",
        "--clang-tidy"
      ],
      "enabled": true
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },
    "nuget": {
      "type": "local",
      "command": [
        "dnx",
        "NuGet.Mcp.Server@1.4.16",
        "--source",
        "https://api.nuget.org/v3/index.json",
        "--yes"
      ],
      "enabled": true
    },
    "gopls": {
      "type": "local",
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true
    },
    "pkg-go-dev": {
      "type": "local",
      "command": [
        "godig",
        "mcp"
      ],
      "enabled": true
    },
    "javadocs": {
      "type": "remote",
      "url": "https://www.javadocs.dev/mcp",
      "enabled": true
    },
    "maven-tools": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "arvindand/maven-tools-mcp:3.2.3-noc7"
      ],
      "enabled": true
    },
    "maven-decoder": {
      "type": "local",
      "command": [
        "uvx",
        "maven-decoder-mcp@1.3.2"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--isolated",
        "--no-usage-statistics"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--headless"
      ],
      "enabled": true
    },
    "socket-mcp": {
      "type": "remote",
      "url": "https://mcp.socket.dev/",
      "enabled": true
    },
    "gradle": {
      "type": "local",
      "command": [
        "jbang",
        "run",
        "--quiet",
        "--java",
        "21",
        "--runtime-option=--add-modules=jdk.incubator.vector",
        "dev.rnett.gradle-mcp:gradle-mcp:0.0.16"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd"
      ],
      "enabled": true
    },
    "rust-analyzer": {
      "type": "local",
      "command": [
        "rust-analyzer-mcp"
      ],
      "enabled": true
    },
    "rust-mcp-server": {
      "type": "local",
      "command": [
        "rust-mcp-server"
      ],
      "enabled": true
    },
    "eslint": {
      "type": "local",
      "command": [
        "npx",
        "@eslint/mcp@0.3.15"
      ],
      "enabled": true
    }
  }
}
